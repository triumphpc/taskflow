<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.taskflow.delegation</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__REPO__/agent/run-delegation.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.local/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/taskflow-agent/delegation.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/taskflow-agent/delegation.err.log</string>
</dict>
</plist>
