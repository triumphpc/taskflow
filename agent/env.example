# Имена переменных env-файла ~/.config/taskflow-agent/env (права 0600). Значения здесь нет и быть не должно.
# Файл создаётся командой `sh agent/setup-env.sh` или вручную. Токен сменился: пересоздайте файл
# тем же способом и перезапустите задание launchd (см. agent/README.md).

# Адрес и токен MCP TaskFlow (процесс claude их не наследует)
export TASKFLOW_MCP_URL=
export TASKFLOW_MCP_TOKEN=

# Прокси и его токен, как у claude-paiw
export ANTHROPIC_BASE_URL=
export ANTHROPIC_CUSTOM_HEADERS=

# Рабочее окружение и отключённые навыки, как у claude-paiw
export AI_LAUNCHER_PAIW_WORKSPACE=
export AI_LAUNCHER_PAIW_DISABLED_ITEMS=

# Если их задаёт claude-paiw
export HTTP_PROXY=
export HTTPS_PROXY=
export NO_PROXY=
export no_proxy=

# Абсолютный путь к claude: у launchd короткий PATH
export CLAUDE_BIN=

# Рабочий каталог процесса claude
# export TASKFLOW_AGENT_CWD=   # по умолчанию пустая песочница ~/.local/state/taskflow-agent/work (0700); домашний каталог запрещён
# Запасной способ запуска через `zsh -ic claude-paiw` (только если spike U1 провалился)
# export TASKFLOW_AGENT_LAUNCH=fallback

# Отправка из делегирования (VK Teams, комментарии в MR и Jira, страницы Confluence) под хуком-gate.
# Поставляется ВЫКЛЮЧЕННОЙ: пока не пройдены спайки S1 и S3 (agent/spike/send/), оставьте off.
# Opt-in: режим с отправкой включает ТОЛЬКО строка `export TASKFLOW_AGENT_SEND=on`. Без строки, с пустым значением,
# с `off` или с опечаткой демон остаётся в режиме «только чтение».
export TASKFLOW_AGENT_SEND=off
# Путь к файлу политики (белые списки, потолки); по умолчанию ~/.config/taskflow-agent/send-policy.json, права 0600
# export TASKFLOW_AGENT_SEND_POLICY=
